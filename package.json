{
  "name": "@wwl/wwl-cbun",
  "version": "1.0.0",
  "private": true,
  "description": "Weekend Web Labs miscellaneous Vue 3 component bundle \u2014 code-editor, draw, hex-grid, music-player",
  "type": "module",
  "license": "MIT",
  "author": "nostromo-618",
  "homepage": "https://github.com/nostromo-618/wwl-cbun#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostromo-618/wwl-cbun.git"
  },
  "bugs": {
    "url": "https://github.com/nostromo-618/wwl-cbun/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./code-editor": {
      "types": "./dist/code-editor/index.d.ts",
      "import": "./dist/code-editor/index.js",
      "require": "./dist/code-editor/index.cjs"
    },
    "./code-editor/highlight": {
      "types": "./dist/code-editor/highlight.d.ts",
      "import": "./dist/code-editor/highlight.js",
      "require": "./dist/code-editor/highlight.cjs"
    },
    "./code-editor/css": "./dist/code-editor/vd3-code-editor.css",
    "./draw": {
      "types": "./dist/draw/index.d.ts",
      "import": "./dist/draw/index.js",
      "require": "./dist/draw/index.cjs"
    },
    "./draw/css": "./dist/draw/vd3-draw.css",
    "./hex-grid": {
      "types": "./dist/hex-grid/index.d.ts",
      "import": "./dist/hex-grid/index.js",
      "require": "./dist/hex-grid/index.cjs"
    },
    "./hex-grid/hex-math": {
      "types": "./dist/hex-grid/hex-math.d.ts",
      "import": "./dist/hex-grid/hex-math.js",
      "require": "./dist/hex-grid/hex-math.cjs"
    },
    "./music-player": {
      "types": "./dist/music-player/index.d.ts",
      "import": "./dist/music-player/index.js",
      "require": "./dist/music-player/index.cjs"
    },
    "./music-player/css": "./dist/music-player/vd3-music-player.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "wwl",
    "labs",
    "vue",
    "components",
    "code-editor",
    "draw",
    "hex-grid",
    "music-player"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,ts}\" \"scripts/**/*.js\" \"tests/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts}\" \"scripts/**/*.js\" \"tests/**/*.{js,ts}\"",
    "stylelint": "stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:types": "tsc --noEmit -p tests/types/tsconfig.json",
    "test:e2e": "playwright test",
    "prepack": "pnpm run build",
    "release": "pnpm run build"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vue/test-utils": "2.5.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11",
    "vue": "3.5.43"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.2"
}
